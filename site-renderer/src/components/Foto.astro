---
import { manifest, RITAGLIO, sizesPerZoom, TELEFONO_MAX, type Candidato } from "@/lib/media";

// Ogni immagine dei componenti passa da qui (piano T1b, «pagine leggere»).
// Senza manifest delle varianti (servizio Traffico «Sito» spento, anteprime, dev) rende
// l'<img> di sempre, con gli stessi attributi nello stesso ordine: l'HTML dei siti non cambia.
// Con la voce nel manifest rende <picture> con AVIF e il ripiego JPEG/PNG, `srcset` e
// `sizes` per l'uso (sizesPerZoom: resa onesta fino a 767 px, × ZOOM oltre), `width`/`height`
// (solo il rapporto: il riquadro lo decidono le classi) e `decoding="async"` sulle foto pigre.
// SVG e GIF ricevono solo le dimensioni.
// Telefoni (piano T1c): prima della serie di sempre un <source media> con i candidati da
// telefono fino a 767 px (AVIF per le foto, PNG per logo e marchio: il computer sceglie gli
// stessi file di prima); per la foto della hero a tutta pagina, al suo posto, il ritaglio da
// telefono fino a 430 px (oltre resta la serie di sempre, decisioni-piani.md T1c punto 2).
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high";
  /** Larghezza resa, da SIZES / sizesGalleria / sizesLogo di lib/media.ts. */
  sizes: string;
  /** Solo la foto a tutta pagina della hero (varianti A, C, D): usa il ritaglio da telefono del manifest. */
  ritaglioTelefono?: boolean;
}
const { src, alt, class: cls, loading, fetchpriority, ritaglioTelefono } = Astro.props;

const v = manifest?.immagini[src];
const sizes = v ? sizesPerZoom(Astro.props.sizes) : "";
const ripiego = v?.jpeg ?? v?.png;
const ritaglio = ritaglioTelefono ? v?.ritaglio : undefined;
const telefono = ritaglio ? undefined : v?.telefono;
const srcset = (c: Candidato[]) => c.map(([url, w]) => `${url} ${w}w`).join(", ");
// `src` dell'<img> per i browser senza srcset: la variante più larga fino a 1280 px.
const srcRipiego = ripiego ? (ripiego.filter(([, w]) => w <= 1280).at(-1) ?? ripiego[0])[0] : src;
const decoding = loading === "lazy" ? "async" : undefined;
---

{/* alt vuoto (decorativa) come alt="" letterale: con un valore dinamico vuoto Astro
    stamperebbe il solo `alt` e l'HTML a servizio spento cambierebbe */}
{!v && alt !== "" && <img src={src} alt={alt} class={cls} loading={loading} fetchpriority={fetchpriority} />}
{!v && alt === "" && <img src={src} alt="" class={cls} loading={loading} fetchpriority={fetchpriority} />}
{v && !ripiego && <img src={src} width={v.w} height={v.h} alt={alt} class={cls} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />}
{
  v && ripiego && (
    <picture>
      {ritaglio && <source media={RITAGLIO.media} type="image/avif" srcset={srcset(ritaglio.avif)} sizes={RITAGLIO.sizes} width={ritaglio.w} height={ritaglio.h} />}
      {telefono && <source media={`(max-width: ${TELEFONO_MAX}px)`} type={v.avif ? "image/avif" : undefined} srcset={srcset(telefono)} sizes={sizes} />}
      {v.avif && <source type="image/avif" srcset={srcset(v.avif)} sizes={sizes} />}
      <img src={srcRipiego} srcset={srcset(ripiego)} sizes={sizes} width={v.w} height={v.h} alt={alt} class={cls} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />
    </picture>
  )
}
