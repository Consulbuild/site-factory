---
import Base from "@/layouts/Base.astro";
import { registry } from "@/lib/registry";
import { parseSiteConfig } from "@/lib/schema";
import siteData from "../../blueprints/conversione-locale-v1/blueprint.json";

// Valida il BLUEPRINT contro lo schema Zod (applica i default): il blueprint è
// sia lo scheletro che la pipeline riempie (vedi blueprints/README.md) sia il
// golden example che il renderer mostra in dev. Una sola fonte di verità.
// In produzione l'editor scriverà qui il site.json del cliente.
const site = parseSiteConfig(siteData);
---

<Base site={site}>
  <span id="top"></span>
  {site.sections.map((section) => {
    const Comp = registry[section.type];
    const variant = "variant" in section ? section.variant : undefined;
    return <Comp data={section.props} site={site} variant={variant} />;
  })}
</Base>
