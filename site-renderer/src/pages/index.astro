---
import Base from "@/layouts/Base.astro";
import { registry } from "@/lib/registry";
import { site } from "@/lib/loadSite";

// Il site.json arriva da loadSite (validato Zod): di default è il blueprint
// golden; con SITE_JSON è il sito di un cliente prodotto dalla pipeline.
---

<Base site={site}>
  <span id="top"></span>
  {site.sections.map((section) => {
    const Comp = registry[section.type];
    const variant = "variant" in section ? section.variant : undefined;
    return <Comp data={section.props} site={site} variant={variant} />;
  })}
</Base>
