---
import type { PropsOf, SiteConfig } from "@/lib/schema";
import Icon from "@/components/Icon.astro";
import { telHref, waHref } from "@/lib/ui";

interface Props {
  data: PropsOf<"StickyCta">;
  site: SiteConfig;
  variant?: string;
}
const { data, site } = Astro.props;
const c = site.contact;

// FAB di chiamata SOLO MOBILE (scelta 2026-07-03): cerchio accent fisso in
// basso a destra con cornetta bianca — il tap-to-call sempre a portata di
// pollice per il visitatore da ads. WhatsApp opzionale sopra, tono scuro.
// safe-area per iPhone con home indicator.
const showCall = data.showCall && c.phone;
const showWa = data.showWhatsapp && c.whatsapp;
---

{(showCall || showWa) && (
  <div
    class="fixed bottom-4 right-4 z-40 flex flex-col items-center gap-3 md:hidden"
    style="margin-bottom: env(safe-area-inset-bottom)"
  >
    {showWa && (
      <a
        href={waHref(c.whatsapp)}
        aria-label="Scrivici su WhatsApp"
        class="grid h-12 w-12 place-items-center rounded-full bg-inverse-bg text-white shadow-float"
      >
        <Icon name="message" class="h-5 w-5" />
      </a>
    )}
    {showCall && (
      <a
        href={telHref(c.phone)}
        aria-label={`Chiama ${c.phone}`}
        class="grid h-14 w-14 place-items-center rounded-full bg-primary text-white shadow-float"
      >
        <Icon name="phone" class="h-6 w-6" />
      </a>
    )}
  </div>
)}
