---
import type { PropsOf, SiteConfig } from "@/lib/schema";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { sectionPad } from "@/lib/ui";

interface Props {
  data: PropsOf<"Services">;
  site: SiteConfig;
  variant?: string;
}
const { data, variant = "grid" } = Astro.props;

// Card servizio dello standard: foto in testa, titolo, descrizione e checklist
// con spunte accent — la prova concreta di cosa include il servizio.
// variant "list": righe orizzontali foto+testo per servizi più discorsivi.
const isList = variant === "list";

// Griglia count-aware: mai card orfane. Con 5 card l'auto-fit farebbe 4+1 —
// a xl stanno tutte su una riga (10 colonne, card da 2), a lg (dove 5 colonne
// sarebbero troppo strette) ritmo 3+2 centrato via col-start sulla quarta.
// Nel tratto a 2 colonne (sm→lg) un conteggio dispari centra l'ultima card
// alla stessa larghezza delle altre (50% della riga meno mezzo gap-6).
// Con 3–4 card le classi restano quelle storiche: resa invariata.
const n = data.items.length;
const five = n === 5;
const gridCols = five
  ? "sm:grid-cols-2 lg:grid-cols-6 xl:grid-cols-10"
  : "sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(250px,1fr))]";
const cardCols = (i: number) => [
  five && "lg:col-span-2",
  five && i === 3 && "lg:col-start-2 xl:col-start-auto",
  n % 2 === 1 &&
    i === n - 1 &&
    "sm:col-span-2 sm:w-full sm:max-w-[calc(50%-0.75rem)] sm:justify-self-center lg:max-w-none lg:justify-self-auto",
  n % 2 === 1 && i === n - 1 && !five && "lg:col-span-1",
];
---

<section class:list={[sectionPad, "bg-surface"]} id="servizi" aria-labelledby="servizi-title">
  <div class="container-site">
    <SectionHeader id="servizi-title" eyebrow={data.eyebrow} title={data.title} sub={data.subtitle} />

    {!isList && (
      <ul class:list={["mt-12 grid gap-6", gridCols]}>
        {data.items.map((item, i) => (
          <li
            class:list={["surface-card surface-card--hover flex flex-col overflow-hidden", ...cardCols(i)]}
          >
            {item.image && (
              <img
                src={item.image.src}
                alt={item.image.alt}
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="flex grow flex-col p-6">
              <h3 class="t-h4 font-bold">{item.title}</h3>
              <p class="mt-2 text-muted">{item.desc}</p>
              {item.bullets.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-line pt-5">
                  {item.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 t-caption font-medium">
                      <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
                      {b}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}

    {isList && (
      <ul class="mt-12 space-y-6">
        {data.items.map((item, i) => (
          <li
            class="surface-card surface-card--hover grid overflow-hidden sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"
          >
            {item.image && (
              <img
                src={item.image.src}
                alt={item.image.alt}
                class="h-full min-h-48 w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="p-6 sm:p-8">
              <h3 class="t-h4 font-bold">{item.title}</h3>
              <p class="mt-2 max-w-[60ch] text-muted">{item.desc}</p>
              {item.bullets.length > 0 && (
                <ul class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-2">
                  {item.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 t-caption font-medium">
                      <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
                      {b}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}

    {data.cta && (
      <div class="mt-12 text-center">
        <Button cta={data.cta} />
      </div>
    )}
  </div>
</section>
