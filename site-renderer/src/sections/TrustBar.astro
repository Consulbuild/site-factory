---
import type { PropsOf, SiteConfig } from "@/lib/schema";

interface Props {
  data: PropsOf<"TrustBar">;
  site: SiteConfig;
  variant?: string;
}
const { data } = Astro.props;

// Strip di fiducia subito sotto l'hero: tono più scuro dell'hero per staccare,
// voci "titolo + sottotitolo" separate da hairline verticali (come nei siti
// di riferimento: PROGETTAZIONE 3D / TEAM ESPERTO / SOLUZIONI COMPLETE).
---

<section class="section-dark section-dark--deep border-y border-inverse-ink/10">
  <ul class="container-site flex flex-wrap justify-center py-2">
    {data.items.map((item) => (
      <li class="min-w-[12rem] flex-1 border-inverse-ink/10 px-6 py-5 text-center not-first:border-t sm:not-first:border-t-0 sm:py-6 sm:not-first:border-l">
        <p class="t-caption font-bold uppercase tracking-[0.1em]">{item.value}</p>
        <p class="t-caption mt-1 text-muted">{item.label}</p>
      </li>
    ))}
  </ul>
</section>
