---
import "../styles/global.css";
import type { SiteConfig } from "@/lib/schema";
import { customFontsHref, type Preset } from "@/lib/presets";

interface Props {
  site: SiteConfig;
  pageTitle?: string; // sottopagine (legali, grazie): "Titolo · NomeAzienda"
  noindex?: boolean; // sottopagine di servizio fuori dai motori
}
const { site, pageTitle, noindex = false } = Astro.props;
const { brand, meta } = site;
const preset = brand.preset as Preset;

// Inietta INLINE solo i token brand realmente forniti dal cliente: vincono sul
// preset, ma ciò che il cliente non dà resta governato dal preset (neutri inclusi).
const p = brand.palette;
const vars: string[] = [`--brand-primary:${p.primary}`, `--brand-accent:${p.accent}`];
if (p.secondary) vars.push(`--brand-secondary:${p.secondary}`);
if (p.bg) vars.push(`--brand-bg:${p.bg}`);
if (p.surface) vars.push(`--brand-surface:${p.surface}`);
if (p.ink) vars.push(`--brand-ink:${p.ink}`);
if (p.muted) vars.push(`--brand-muted:${p.muted}`);
if (brand.fonts.heading) vars.push(`--brand-font-heading:'${brand.fonts.heading}'`);
if (brand.fonts.body) vars.push(`--brand-font-body:'${brand.fonts.body}'`);
if (brand.fonts.mono) vars.push(`--brand-font-mono:'${brand.fonts.mono}'`);
const brandStyle = vars.join(";");

// Font: i font di preset sono self-hosted (@font-face in presets.gen.css, M3);
// il CDN Google si tocca SOLO se il cliente impone famiglie custom.
const overrideFonts = [brand.fonts.heading, brand.fonts.body, brand.fonts.mono].filter(
  (x): x is string => !!x,
);
const fontsHref = overrideFonts.length ? customFontsHref(overrideFonts) : null;

// Kit di trattamenti (Asse 2): data-attr su <html>, accanto a data-preset, così
// i selettori compat [data-preset][data-card] risolvono sullo stesso elemento.
// Ciò che il kit non fissa resta il default del preset.
const kit = site.kit ?? {};
const kitAttrs: Record<string, string> = {};
if (kit.navbar) kitAttrs["data-navbar"] = kit.navbar;
if (kit.card) kitAttrs["data-card"] = kit.card;
if (kit.button) kitAttrs["data-button"] = kit.button;
if (kit.hero) kitAttrs["data-hero"] = kit.hero;
if (kit.sectionHeader) kitAttrs["data-section-header"] = kit.sectionHeader;

const title = pageTitle
  ? `${pageTitle} · ${meta.businessName}`
  : meta.seoTitle || `${meta.businessName}${meta.city ? " · " + meta.city : ""}`;
const description =
  meta.seoDescription ||
  `${meta.businessName}${meta.industry ? " — " + meta.industry : ""}${meta.city ? " a " + meta.city : ""}.`;

// Col dominio reale (SITE_URL al build → Astro.site): canonical assoluta —
// consolida apex/www/workers.dev sui motori — più og:url e og:image (la foto
// hero governa l'anteprima quando il link si condivide su WhatsApp/social).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const heroSrc = site.sections.find((s) => s.type === "Hero")?.props.image?.src;
const ogImage = Astro.site && heroSrc ? new URL(heroSrc, Astro.site).href : null;
---

<!doctype html>
<html lang="it" data-preset={preset} style={brandStyle} {...kitAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {site.brand.favicon && <link rel="icon" href={site.brand.favicon} type="image/svg+xml" />}
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
