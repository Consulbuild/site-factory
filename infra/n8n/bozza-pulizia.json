    {
      "id": "12713d68-b064-472d-b1a7-09e5a53f87bf",
      "name": "Valuta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "// _inbox è un'anticamera: ciò che l'editor non ha importato entro 60 giorni va nel\n// Cestino (dove resta altri 30). Se le cartelle sono più di 300 qualcosa non torna\n// (bot, form in loop): un avviso separato.\n// Dal webhook di prova (header auth) si può passare {\"giorni\": 0} per una prova.\nconst GIORNI = $('Prova').isExecuted ? Number($('Prova').first().json.body?.giorni ?? 60) : 60;\nconst SOGLIA = 300;\nconst tutte = $input.all().map((i) => i.json).filter((f) => f.id);\nconst limite = Date.now() - GIORNI * 864e5;\nconst uscita = tutte.filter((f) => new Date(f.createdTime).getTime() < limite).map((f) => ({ json: { azione: 'cestina', id: f.id, nome: f.name } }));\nif (tutte.length > SOGLIA) uscita.push({ json: { azione: 'allarme', totale: tutte.length } });\nreturn uscita;"
      }
    },
