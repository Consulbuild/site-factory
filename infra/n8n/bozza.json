    {
      "id": "6d021813-eb82-4dd5-9e95-12645faa88c6",
      "name": "Prepara",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "jsCode": "// Le tre route del form (transport.ts) diventano un solo formato:\n// json {route, id, nome, errore} + binary.file (l'immagine caricata oppure la\n// bozza/il lead serializzati come file JSON). Controlli sull'ingresso qui, in un\n// posto solo: id, kind, index, tipo e peso del file.\nconst item = $input.first();\nconst route = { 'Webhook bozza': 'bozza', 'Webhook file': 'file', 'Webhook lead': 'lead' }[$prevNode.name];\nconst id = String(item.json.query?.id ?? '');\nconst pulisci = (n) => n.normalize('NFKD').replace(/[^\\w.-]+/g, '-').replace(/-+/g, '-').toLowerCase().slice(0, 80) || 'file';\nconst errore = (msg) => [{ json: { route, id, nome: '', errore: msg } }];\nif (!/^[a-z0-9-]{8,64}$/i.test(id)) return errore('id non valido');\n\nlet nome, binary, extra = {};\nif (route === 'file') {\n  const body = item.json.body ?? {};\n  const file = item.binary?.file;\n  if (!file) return errore('manca il file');\n  if (!/^image\\//.test(file.mimeType ?? '')) return errore('sono ammesse solo immagini');\n  // Peso reale del binario (l'intestazione content-length non arriva al nodo).\n  if ((await this.helpers.getBinaryDataBuffer(0, 'file')).length > 26 * 1024 * 1024) return errore('file oltre 25 MB');\n  const index = Number(body.index);\n  const ext = (/\\.[a-z0-9]+$/i.exec(file.fileName ?? '')?.[0] ?? '').toLowerCase();\n  if (body.kind === 'logo') nome = 'logo' + (ext || '.bin');\n  else if (body.kind === 'foto' && Number.isInteger(index) && index >= 1 && index <= 15) nome = 'foto-' + String(index).padStart(2, '0') + '-' + pulisci(file.fileName ?? 'foto');\n  else return errore('kind deve essere foto (index 1-15) o logo');\n  binary = { file };\n} else {\n  const corpo = item.json.body;\n  if (!corpo || typeof corpo !== 'object' || Array.isArray(corpo)) return errore('corpo mancante');\n  nome = route === 'lead' ? 'lead.json' : 'bozza.json';\n  binary = { file: await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(corpo, null, 2) + '\\n'), nome, 'application/json') };\n  if (route === 'lead') {\n    // Per l'avviso Telegram (decisione Mattia 2026-09-08: servono nome e azienda per lavorarci).\n    const r = corpo.risposte ?? {};\n    const MESTIERI = { 'impresa-edile': 'Impresa edile', ristrutturazioni: 'Ristrutturazioni', idraulico: 'Idraulico', elettricista: 'Elettricista', cartongesso: 'Cartongesso e controsoffitti', serramenti: 'Serramenti', imbianchino: 'Imbianchino' };\n    extra = {\n      nFoto: Number(corpo.fotoArrivate ?? 0),\n      logo: corpo.logo?.stato === 'fatto' ? 'sì' : 'no',\n      azienda: r.azienda || '(azienda non indicata)',\n      referente: r.referente || '(nome non indicato)',\n      mestiere: r.mestiere?.id === 'altro' ? (r.mestiere?.altro || 'altro') : (MESTIERI[r.mestiere?.id] ?? r.mestiere?.id ?? ''),\n      comune: [r.sede?.comune, r.sede?.provincia ? '(' + r.sede.provincia + ')' : ''].filter(Boolean).join(' '),\n      telefono: r.telefono || '',\n      contatto: r.ricontatto?.id === 'telefonata' ? 'telefonata' : 'WhatsApp',\n    };\n  }\n}\nreturn [{ json: { route, id, nome, errore: '', ...extra }, binary }];"
      }
    },
