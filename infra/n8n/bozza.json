      "parameters": {
        "jsCode": "// Riporta sull'item il file (binario) preparato all'inizio e gli id trovati:\n// la cartella del lead (trovata o appena creata) e il file omonimo, se esiste già\n// (retry del form dopo un timeout: si aggiorna invece di duplicare).\nconst prep = $('Prepara').first();\nconst cartellaId = $('Crea cartella').isExecuted ? $('Crea cartella').first().json.id : $('Cerca cartella').first().json.id;\nconst fileId = $input.first().json.id ?? '';\nreturn [{ json: { ...prep.json, cartellaId, fileId }, binary: prep.binary }];"
