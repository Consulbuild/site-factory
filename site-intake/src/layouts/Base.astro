---
/**
 * Layout unico del form: head essenziale, font preloadato, CSS inline (astro.config:
 * inlineStylesheets "always"), niente script di terzi nel percorso critico.
 * Umami (statistiche senza cookie, come sui siti clienti): host e id del sito «Form
 * bozza» sono i default qui sotto (l'id di un sito Umami è pubblico, sta nell'HTML), così
 * nessun deploy parte senza statistiche; le env PUBLIC_UMAMI_HOST / PUBLIC_UMAMI_WEBSITE_ID
 * li sostituiscono. `data-domains` limita la raccolta al dominio pubblicato: le prove in
 * locale e i test non sporcano i dati.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/motion.css";
import "../styles/upload.css";

interface Props {
  titolo: string;
  descrizione: string;
}
const { titolo, descrizione } = Astro.props;
const umamiHost = import.meta.env.PUBLIC_UMAMI_HOST || "https://stats.consulbuild.com";
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || "36fc183b-fa22-415a-bc0d-a333d1464db0"; // sito «Form bozza» (scripts/umami-form-setup.ts nell'editor)
const umamiDomini = "sito.consulbuild.com";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0f172a" />
    {/* Stessa favicon del sito ConsulBuild (repo Consulbuild_Vercel): ico multi-size + PNG. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-next-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      umamiHost && umamiId && (
        <script is:inline defer src={`${umamiHost}/script.js`} data-website-id={umamiId} data-domains={umamiDomini} data-auto-track="false" />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
